# Root-level ignores. Workspace-specific ignores live in each workspace
# (frontend/.gitignore, and backend/.gitignore when it exists), so patterns
# stay next to the thing they describe.

# dependencies
node_modules/

# env — never commit secrets
.env*

# MCP server config (contains an inline API key)
.mcp.json

# build output
dist/
build/
*.tsbuildinfo

# editor / OS
.DS_Store
Thumbs.db
